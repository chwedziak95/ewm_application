# Copy to secrets.properties (git-ignored) in this folder and fill in the values,
# or set the same names as environment variables.

# MySQL password for the spring.datasource.username user
DB_PASSWORD=

# SMTP credentials (Mailtrap sandbox)
MAIL_USERNAME=
MAIL_PASSWORD=

# Base64-encoded key used to sign JWTs, e.g. output of: openssl rand -base64 32
JWT_SECRET_KEY=

# HTTPS keystore. Generate a new one with:
#   keytool -genkeypair -alias ewmapp -keyalg RSA -keysize 2048 -storetype PKCS12 \
#     -keystore src/main/resources/ewmapp-keystore.p12 -validity 3650
KEYSTORE_PASSWORD=
# Optional: KEYSTORE_PATH=file:/path/to/keystore.p12 (defaults to the classpath copy)
